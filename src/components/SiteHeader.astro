---
const MAP_URL = 'https://akanicy.pl';
const COFFEE_URL = 'https://buymeacoffee.com/siaroza';
const INSTAGRAM_URL = 'https://instagram.com/akanicy_pl';
const EMAIL_URL = 'mailto:hi@siaroza.com';
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__logo" href="/">
			<span class="site-header__mark">
				<img src={`${import.meta.env.BASE_URL}icons/map.svg`} alt="" width="18" height="18" />
			</span>
			<span class="site-header__wordmark">
				<span>Akanicy</span>
				<span>padlašša</span>
			</span>
		</a>

		<nav class="site-header__tabs" aria-label="Site">
			<div class="site-header__tab-list">
				<a class="site-header__tab" href={MAP_URL}>Map</a>
				<a class="site-header__tab is-active" href="/" aria-current="page">Trip</a>
			</div>
		</nav>

		<div class="site-header__actions">
			<a
				class="site-header__icon"
				href={INSTAGRAM_URL}
				target="_blank"
				rel="noreferrer"
				aria-label="Instagram"
			>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"
					></rect>
					<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"></circle>
					<circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"></circle>
				</svg>
			</a>
			<a class="site-header__icon" href={EMAIL_URL} aria-label="Email">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"
					></rect>
					<path
						d="M4 7.5 12 13l8-5.5"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"></path>
				</svg>
			</a>
			<a
				class="site-header__coffee"
				href={COFFEE_URL}
				target="_blank"
				rel="noreferrer"
			>
				<img src={`${import.meta.env.BASE_URL}icons/coffee.svg`} alt="" width="16" height="16" />
				<span class="site-header__coffee-label">Buy me a coffee</span>
			</a>
		</div>
	</div>
</header>
